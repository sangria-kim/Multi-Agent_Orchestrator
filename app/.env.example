# 작업 데이터 저장 폴더 (app/ 기준 상대 경로). 설정 화면에서 지정하면 그쪽이 우선한다
ORCHESTRATOR_DATA_DIR=./.data
# Agent 실행 타임아웃 (ms). 설정 화면에서 지정하면 그쪽이 우선한다
AGENT_TIMEOUT_MS=300000
# 타임아웃 후 강제 종료까지의 유예 (ms)
AGENT_KILL_GRACE_MS=5000
# claude CLI 실행 경로 (PATH에 있으면 그대로 두면 된다)
CLAUDE_CLI_PATH=claude
# codex CLI 실행 경로
CODEX_CLI_PATH=codex
